.venv/
.venv-analysis/
__pycache__/
*.pyc
*.egg-info/
.env
data/
data
*.zip
.DS_Store

# Local-only archives (preserved offline; not for public distribution)
_archive_mac_syndication_*/
_archive_novelty_proj/

# Paper build intermediates
paper/_bundle_build/
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# Large generated bundle (regenerable from scripts; release asset, not git)
paper/review_bundle.pdf

# Large per-filing intermediate; regenerable from scripts/debut_harvest_fit.py
paper/results/debut_harvest_fit.csv

# Build logs + transient backup files
logs/
*.committed-baseline

# Private outreach drafts (recipient emails; not for public distribution)
outreach/

# Private correspondence and anything quoting a third party's email verbatim.
# notes/ is otherwise a PUBLIC directory - check before adding a file here.
notes/_private/
notes/castaldi_feedback_*.md
notes/revision_plan_castaldi.md

# LaTeX intermediates for notes built into paper/results/
paper/results/*.aux
paper/results/*.log
paper/results/*.out

# PDF-viewer duplicate copies
* - Copy.pdf

# OS / editor noise
Thumbs.db
.idea/
.vscode/
