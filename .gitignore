.venv/
.venv-analysis/
__pycache__/
*.pyc
*.egg-info/
.env
data/
data
*.zip
.DS_Store

# Local-only archives (preserved offline; not for public distribution)
_archive_mac_syndication_*/
_archive_novelty_proj/

# Paper build intermediates
paper/_bundle_build/
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# Large generated bundle (regenerable from scripts; release asset, not git)
paper/review_bundle.pdf

# Large per-filing intermediate; regenerable from scripts/debut_harvest_fit.py
paper/results/debut_harvest_fit.csv

# Build logs + transient backup files
logs/
*.committed-baseline

# Private outreach drafts (recipient emails; not for public distribution)
outreach/

# Private correspondence and anything quoting a third party's email verbatim.
# notes/ is otherwise a PUBLIC directory - check before adding a file here.
notes/_private/
notes/castaldi_feedback_*.md
notes/revision_plan_castaldi.md

# LaTeX intermediates for notes built into paper/results/
paper/results/*.aux
paper/results/*.log
paper/results/*.out

# PDF-viewer duplicate copies
* - Copy.pdf

# OS / editor noise
Thumbs.db
.idea/
.vscode/

# Standalone preview wrapper for the construct section (build artefact)
paper/section_construct_preview.*

# Double-blind build is generated from the identified source by
# paper/anonymize.py; do not commit it, so the two cannot drift.
paper/ssrn_diffusion_paper_blind.tex
paper/ssrn_diffusion_paper_blind.pdf

# Internal working documents. These name third parties and describe private
# context; they are kept locally and must never be published.
PROJECT.md
INBOX.md
BLOCKED.md
docs/README.md
paper/OUTLINE_v2.md
paper/_legacy/
paper/ssrn_diffusion_paper-pre-re-org-*.pdf

# Third-party data that cannot be redistributed under this repo's licence.
# Crunchbase Open Data Map is CC-BY-NC; the NC clause is incompatible with the
# code licence and the attribution requirement is not met by a mirror copy.
data_publish/comparators/crunchbase_companies.csv

# Orphaned scripts carrying pre-rename absolute paths; superseded and unrun.
scripts/newterms_analysis.py
scripts/newterms_build_pdf.py

# Narrated-paper audio renders (scripts/paper_to_audio.py); 300+ MB of WAV, regenerable
paper/audio/

# Per-class cache for scripts/window_mix_rolling.py (~2 h to rebuild on CORE)
paper/results/window_mix_parts/

# v3 build intermediates
paper/v3/*.aux
paper/v3/*.log
paper/v3/*.out
paper/v3/*.toc
paper/v3/main.pdf

# Per-filing T=500 dominant-theme cache (rebuilt by scripts/theme_novelty_origin.py, ~1h)
paper/results/theme_novelty_cache/
